{
  "description": "SSSF native-subagent lifecycle tracing",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 adws/adw_modules/codex_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 adws/adw_modules/codex_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
